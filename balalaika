<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Балалайка — Ми-Ми-Ля 🎵</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #1a0a2e, #16213e, #0f3460);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            color: #fff;
            user-select: none;
        }
        h1 { color: #f4d35e; font-size: 2.2rem; margin-bottom: 4px; text-shadow: 2px 2px 10px rgba(244,211,94,0.5); }
        .subtitle { color: #a8dadc; font-size: 0.95rem; margin-bottom: 20px; text-align: center; line-height: 1.5; }
        .subtitle strong { color: #f4d35e; }
        .container { position: relative; display: flex; flex-direction: column; align-items: center; }

        /* === БАЛАЛАЙКА === */
        .balalaika { position: relative; width: 340px; height: 540px; }

        /* Головка */
        .head {
            position: absolute; top: -10px; left: 50%; transform: translateX(-50%);
            width: 56px; height: 56px;
            background: linear-gradient(180deg, #654321, #8B4513);
            border-radius: 10px 10px 0 0; z-index: 4;
            display: flex; justify-content: space-around; align-items: flex-end;
            padding: 0 6px 6px;
        }
        .peg { width: 10px; height: 20px; background: linear-gradient(90deg, #bbb, #eee, #bbb); border-radius: 4px; }

        /* Гриф */
        .neck {
            position: absolute; top: 30px; left: 50%; transform: translateX(-50%);
            width: 44px; height: 260px;
            background: linear-gradient(90deg, #7B3F00, #A0522D, #7B3F00);
            border-radius: 18px 18px 0 0;
            box-shadow: inset 1px 0 3px rgba(0,0,0,0.3), inset -1px 0 3px rgba(0,0,0,0.3);
            z-index: 2;
        }

        /* Металлические лады */
        .frets-layer {
            position: absolute; top: 30px; left: 50%; transform: translateX(-50%);
            width: 42px; height: 260px; z-index: 5;
        }
        .fret-mark {
            position: absolute; left: -1px; right: -1px; height: 2px;
            background: linear-gradient(90deg, #aaa, #fff, #ccc, #fff, #aaa);
            box-shadow: 0 1px 2px rgba(0,0,0,0.4);
            transition: background 0.2s;
        }
        .fret-mark.active {
            background: linear-gradient(90deg, #f4d35e, #fff, #f4d35e);
            box-shadow: 0 0 8px rgba(244,211,94,0.8);
            height: 3px;
        }

        /* Метки ладов (точки) */
        .fret-dot {
            position: absolute; width: 8px; height: 8px; border-radius: 50%;
            background: #f4d35e; opacity: 0.4;
            left: 50%; transform: translateX(-50%);
        }
        .fret-dot.active { opacity: 1; box-shadow: 0 0 6px #f4d35e; }

        /* Накладка грифа (пальцевая зона) */
        .fingerboard {
            position: absolute; top: 30px; left: 50%; transform: translateX(-50%);
            width: 42px; height: 260px; z-index: 3;
            display: flex; flex-direction: column;
        }
        .fret-zone {
            flex: 1;
            border-bottom: 1px solid rgba(100,50,0,0.3);
            display: flex; justify-content: space-around; align-items: center;
            transition: background 0.15s;
            cursor: default;
        }
        .fret-zone.highlight { background: rgba(244,211,94,0.25); }
        .fret-zone.pressed { background: rgba(255,100,100,0.35); }

        /* Корпус */
        .body-bg {
            position: absolute; top: 255px; left: 50%; transform: translateX(-50%);
            width: 0; height: 0;
            border-left: 150px solid transparent; border-right: 150px solid transparent;
            border-bottom: 285px solid #8B6914; z-index: 0;
        }
        .body-main {
            position: absolute; top: 260px; left: 50%; transform: translateX(-50%);
            width: 0; height: 0;
            border-left: 144px solid transparent; border-right: 144px solid transparent;
            border-bottom: 276px solid #C4883A;
            filter: drop-shadow(3px 3px 10px rgba(0,0,0,0.5));
            z-index: 1;
        }

        /* Розетка */
        .soundhole {
            position: absolute; top: 390px; left: 50%; transform: translateX(-50%);
            width: 64px; height: 64px; border-radius: 50%;
            background: radial-gradient(circle, #1a0e08 55%, #6B4423 60%, #8B6914 70%, #C4883A 100%);
            border: 3px solid #8B6914; z-index: 2;
        }
        .soundhole::before {
            content: ''; position: absolute; top: -12px; left: -12px; width: 88px; height: 88px;
            border-radius: 50%; border: 2px dashed rgba(244,211,94,0.5);
            animation: rotateSlow 25s linear infinite;
        }
        @keyframes rotateSlow { to { transform: rotate(360deg); } }

        /* Подставка */
        .bridge {
            position: absolute; top: 490px; left: 50%; transform: translateX(-50%);
            width: 50px; height: 8px;
            background: linear-gradient(180deg, #f0e68c, #8B6914);
            border-radius: 2px; z-index: 6;
        }

        /* === СТРУНЫ === */
        .strings-container {
            position: absolute; top: 10px; left: 50%; transform: translateX(-50%);
            width: 28px; height: 500px; z-index: 7;
            display: flex; justify-content: space-around;
        }
        .string {
            width: 3px; height: 100%; position: relative;
            border-radius: 1.5px;
        }
        .string-1 { background: linear-gradient(180deg, #f0e68c, #fffacd, #f0e68c); }
        .string-2 { background: linear-gradient(180deg, #f0e68c, #fffacd, #f0e68c); }
        .string-3 { background: linear-gradient(180deg, #e8d5a0, #f5edd0, #e8d5a0); width: 4px; }

        .string.vibrating { animation: vibrate 0.1s ease-in-out 10; }
        .string.glow { box-shadow: 0 0 12px 5px rgba(255,215,0,0.7); }
        @keyframes vibrate {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-6px); }
            75% { transform: translateX(6px); }
        }

        /* Подписи струн */
        .string-labels {
            position: absolute; top: 4px; left: 50%; transform: translateX(-50%);
            width: 28px; height: 14px; z-index: 8;
            display: flex; justify-content: space-around;
        }
        .str-label {
            font-size: 0.6rem; color: #f4d35e; font-weight: bold;
            text-shadow: 0 0 4px rgba(244,211,94,0.8);
        }

        /* Настройка (инфо) */
        .tuning-info {
            margin-top: 8px;
            display: flex; gap: 30px;
            color: #a8dadc; font-size: 0.85rem;
        }
        .tuning-info span { display: flex; align-items: center; gap: 5px; }
        .tuning-info .dot { width: 10px; height: 10px; border-radius: 50%; }
        .dot-e { background: #f4d35e; }
        .dot-a { background: #a8dadc; }

        /* КНОПКИ НОТ */
        .keys-panel {
            margin-top: 20px;
            display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;
            max-width: 520px;
        }
        .note-btn {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            width: 64px; height: 64px; border: none; border-radius: 14px; cursor: pointer;
            font-size: 1.3rem; font-weight: bold; color: #fff; position: relative;
            overflow: hidden; transition: all 0.1s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }
        .note-btn::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 50%;
            background: rgba(255,255,255,0.12); border-radius: 14px 14px 0 0;
        }
        .note-btn:active, .note-btn.pressed { transform: scale(0.92) translateY(2px); box-shadow: 0 2px 8px rgba(0,0,0,0.4); }
        .note-btn .key-hint { font-size: 0.65rem; opacity: 0.85; margin-top: 3px; font-weight: normal; }
        .note-btn .freq { font-size: 0.55rem; opacity: 0.7; margin-top: 1px; font-weight: normal; }
        .note-btn:nth-child(1) { background: linear-gradient(135deg, #e74c3c, #c0392b); }
        .note-btn:nth-child(2) { background: linear-gradient(135deg, #e67e22, #d35400); }
        .note-btn:nth-child(3) { background: linear-gradient(135deg, #f1c40f, #d4a017); }
        .note-btn:nth-child(4) { background: linear-gradient(135deg, #2ecc71, #27ae60); }
        .note-btn:nth-child(5) { background: linear-gradient(135deg, #1abc9c, #16a085); }
        .note-btn:nth-child(6) { background: linear-gradient(135deg, #3498db, #2980b9); }
        .note-btn:nth-child(7) { background: linear-gradient(135deg, #9b59b6, #8e44ad); }
        .note-btn.open-strings {
            background: linear-gradient(135deg, #6c5ce7, #a55eea);
            width: 100%; max-width: 220px; height: 48px;
            font-size: 1rem; margin-top: 5px;
        }

        /* Индикатор текущей ноты */
        .current-note {
            margin-top: 12px;
            font-size: 1.5rem; color: #f4d35e;
            text-shadow: 0 0 15px rgba(244,211,94,0.6);
            min-height: 2rem;
        }

        .instructions {
            margin-top: 12px; color: #a8dadc; text-align: center;
            font-size: 0.8rem; line-height: 1.5; opacity: 0.7; max-width: 400px;
        }

        /* Частицы */
        .particle {
            position: absolute; pointer-events: none; border-radius: 50%;
            animation: particleFade 0.8s ease-out forwards; z-index: 20;
        }
        @keyframes particleFade {
            0% { opacity: 1; transform: translate(0, 0) scale(1); }
            100% { opacity: 0; transform: translate(var(--tx), var(--ty)) scale(0); }
        }
        .note-wave {
            position: absolute; pointer-events: none; font-size: 2rem;
            animation: floatUp 1.2s ease-out forwards; z-index: 20;
        }
        @keyframes floatUp {
            0% { opacity: 1; transform: translateY(0) scale(1); }
            100% { opacity: 0; transform: translateY(-120px) scale(0.5); }
        }
    </style>
</head>
<body>
    <h1>🎶 Балалайка-прима</h1>
    <p class="subtitle">
        3 струны: <strong>Ми — Ми — Ля</strong> (E4–E4–A3)<br>
        Нажимай лады или клавиши, чтобы играть ноты
    </p>

    <div class="container">
        <div class="balalaika">
            <!-- Головка -->
            <div class="head">
                <div class="peg" title="Ля (A3)"></div>
                <div class="peg" title="Ми (E4)"></div>
                <div class="peg" title="Ми (E4)"></div>
            </div>

            <!-- Подписи струн -->
            <div class="string-labels">
                <span class="str-label">E</span>
                <span class="str-label">E</span>
                <span class="str-label">A</span>
            </div>

            <!-- Гриф -->
            <div class="neck"></div>

            <!-- Лады -->
            <div class="frets-layer" id="fretsLayer"></div>

            <!-- Зоны нажатия -->
            <div class="fingerboard" id="fingerboard"></div>

            <!-- Корпус -->
            <div class="body-bg"></div>
            <div class="body-main"></div>
            <div class="soundhole"></div>
            <div class="bridge"></div>

            <!-- Струны -->
            <div class="strings-container">
                <div class="string string-3" id="str2" title="Ля (A3 = 220 Гц)"></div>
                <div class="string string-2" id="str1" title="Ми (E4 = 329.63 Гц)"></div>
                <div class="string string-1" id="str0" title="Ми (E4 = 329.63 Гц)"></div>
            </div>
        </div>

        <!-- Инфо о настройке -->
        <div class="tuning-info">
            <span><span class="dot dot-e"></span> 1-я струна: Ми (E4)</span>
            <span><span class="dot dot-e"></span> 2-я струна: Ми (E4)</span>
            <span><span class="dot dot-a"></span> 3-я струна: Ля (A3)</span>
        </div>

        <div class="current-note" id="currentNote">&nbsp;</div>

        <!-- Кнопки -->
        <div class="keys-panel">
            <button class="note-btn" data-note="0">До<span class="key-hint">A</span><span class="freq">261.6 Гц</span></button>
            <button class="note-btn" data-note="1">Ре<span class="key-hint">S</span><span class="freq">293.7 Гц</span></button>
            <button class="note-btn" data-note="2">Ми<span class="key-hint">D</span><span class="freq">329.6 Гц</span></button>
            <button class="note-btn" data-note="3">Фа<span class="key-hint">F</span><span class="freq">349.2 Гц</span></button>
            <button class="note-btn" data-note="4">Соль<span class="key-hint">G</span><span class="freq">392.0 Гц</span></button>
            <button class="note-btn" data-note="5">Ля<span class="key-hint">H</span><span class="freq">440.0 Гц</span></button>
            <button class="note-btn" data-note="6">Си<span class="key-hint">J</span><span class="freq">493.9 Гц</span></button>
            <button class="note-btn open-strings" id="openBtn">🎸 Открытые струны (Ми-Ми-Ля)<span class="key-hint">Клавиша: Z</span></button>
        </div>
    </div>

    <p class="instructions">
        Клавиши <strong>A S D F G H J</strong> — ноты | <strong>Z</strong> — открытые струны<br>
        На грифе подсвечивается лад, который нужно прижать
    </p>

    <script>
        // ==================== АУДИО ====================
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;

        function ensureAudioCtx() {
            if (!audioCtx) audioCtx = new AudioContext();
            if (audioCtx.state === 'suspended') audioCtx.resume();
        }

        // Ноты 4-й октавы
        const noteNames = ['До','Ре','Ми','Фа','Соль','Ля','Си'];
        const noteFreqs = [261.63, 293.66, 329.63, 349.23, 392.00, 440.00, 493.88];
        const noteKeys  = ['a','s','d','f','g','h','j'];

        // Открытые струны: E4, E4, A3
        const openStrings = [329.63, 329.63, 220.00];

        // Лады для каждой ноты на каждой струне
        // Струны: 0=E4(329.63), 1=E4(329.63), 2=A3(220)
        // Открытая = лад 0
        function fretForString(stringIndex, targetFreq) {
            const openFreq = openStrings[stringIndex];
            // f = openFreq * 2^(fret/12)  =>  fret = 12 * log2(targetFreq / openFreq)
            if (Math.abs(targetFreq - openFreq) < 0.5) return 0; // открытая
            return Math.round(12 * Math.log2(targetFreq / openFreq));
        }

        // ==================== ЗВУК БАЛАЛАЙКИ ====================
        function playBalalaikaString(freq, delay = 0) {
            ensureAudioCtx();
            const t = audioCtx.currentTime + delay;

            // Гармонический спектр щипковой струны
            const harmCount = 28;
            const real = new Float32Array(harmCount + 1);
            const imag = new Float32Array(harmCount + 1);
            for (let i = 1; i <= harmCount; i++) {
                imag[i] = 1.0 / Math.pow(i, 0.65); // чуть ярче чем раньше
            }
            const wave = audioCtx.createPeriodicWave(real, imag, { disableNormalization: false });

            // Основной осциллятор
            const osc = audioCtx.createOscillator();
            osc.setPeriodicWave(wave);
            // Микро-бенд вниз в момент щипка
            osc.frequency.setValueAtTime(freq * 0.982, t);
            osc.frequency.exponentialRampToValueAtTime(freq, t + 0.05);

            // Огибающая: резкая атака, быстрое затухание (характерно для балалайки)
            const gain = audioCtx.createGain();
            gain.gain.setValueAtTime(0, t);
            gain.gain.linearRampToValueAtTime(0.32, t + 0.004);
            // Двойное затухание: быстрое + медленный хвост
            gain.gain.exponentialRampToValueAtTime(0.04, t + 0.15);
            gain.gain.exponentialRampToValueAtTime(0.001, t + 1.0);

            // Резонанс деревянного корпуса
            const bodyFilter = audioCtx.createBiquadFilter();
            bodyFilter.type = 'bandpass';
            // Резонанс зависит от частоты — ниже для басовых, выше для высоких
            bodyFilter.frequency.setValueAtTime(700 + freq * 0.8, t);
            bodyFilter.Q.setValueAtTime(3.5, t);

            // Шум медиатора
            const bufLen = Math.floor(audioCtx.sampleRate * 0.035);
            const buf = audioCtx.createBuffer(1, bufLen, audioCtx.sampleRate);
            const d = buf.getChannelData(0);
            for (let i = 0; i < bufLen; i++) d[i] = (Math.random() * 2 - 1) * 0.5;
            const noise = audioCtx.createBufferSource();
            noise.buffer = buf;
            const nGain = audioCtx.createGain();
            nGain.gain.setValueAtTime(0.1, t);
            nGain.gain.exponentialRampToValueAtTime(0.001, t + 0.05);
            const hp = audioCtx.createBiquadFilter();
            hp.type = 'highpass';
            hp.frequency.value = 2000;

            // Коммутация
            osc.connect(bodyFilter);
            bodyFilter.connect(gain);
            gain.connect(audioCtx.destination);

            noise.connect(hp);
            hp.connect(nGain);
            nGain.connect(audioCtx.destination);

            osc.start(t);
            osc.stop(t + 1.3);
            noise.start(t);
            noise.stop(t + 0.07);
        }

        function playNote(index) {
            const freq = noteFreqs[index];

            // Играем на всех 3 струнах (прижимаем к нужному ладу)
            // Добавляем крошечную задержку между струнами для реалистичности
            playBalalaikaString(freq, 0.000);
            playBalalaikaString(freq, 0.005);
            playBalalaikaString(freq, 0.010);

            // Показываем лады
            highlightFrets(index);

            // Визуал
            animateStrings();
            createParticles(index);
            createNoteWave(index);

            document.getElementById('currentNote').textContent = noteNames[index] + ' (' + freq.toFixed(1) + ' Гц)';
        }

        function playOpenStrings() {
            // E4, E4, A3 — все три открытые
            playBalalaikaString(openStrings[0], 0.000);
            playBalalaikaString(openStrings[1], 0.006);
            playBalalaikaString(openStrings[2], 0.012);

            highlightFrets(-1); // открытые

            animateStrings();
            createParticles(2); // Ми
            createNoteWave(2);

            document.getElementById('currentNote').textContent = 'Ми–Ми–Ля (E4–E4–A3)';
        }

        // ==================== ГРИФ: ЛАДЫ ====================
        const NUM_FRETS = 12;
        const fingerboard = document.getElementById('fingerboard');
        const fretsLayer = document.getElementById('fretsLayer');

        // Создаём зоны ладов
        const fretZones = [];
        for (let i = 0; i < NUM_FRETS; i++) {
            const zone = document.createElement('div');
            zone.className = 'fret-zone';
            zone.dataset.fret = i;
            fingerboard.appendChild(zone);
            fretZones.push(zone);

            // Линия лада
            const mark = document.createElement('div');
            mark.className = 'fret-mark';
            mark.style.top = ((i + 1) / NUM_FRETS * 100) + '%';
            fretsLayer.appendChild(mark);

            // Точки на определённых ладах (как на реальном инструменте)
            if ([3, 5, 7, 9].includes(i)) {
                const dot = document.createElement('div');
                dot.className = 'fret-dot';
                dot.style.top = ((i + 0.5) / NUM_FRETS * 100) + '%';
                fretsLayer.appendChild(dot);
                zone.appendChild(dot);
            }
        }

        function highlightFrets(noteIndex) {
            // Сброс
            fretZones.forEach(z => { z.classList.remove('highlight', 'pressed'); });
            document.querySelectorAll('.fret-mark').forEach(m => m.classList.remove('active'));
            document.querySelectorAll('.fret-dot').forEach(d => d.classList.remove('active'));

            if (noteIndex === -1) {
                // Открытые струны — подсветить верхнюю часть
                fretZones.forEach(z => z.classList.add('highlight'));
                return;
            }

            // Для каждой струны вычисляем нужный лад
            const freq = noteFreqs[noteIndex];
            const frets = [0, 1, 2].map(si => fretForString(si, freq));

            frets.forEach(fret => {
                if (fret >= 0 && fret < NUM_FRETS) {
                    fretZones[fret].classList.add('pressed');
                }
            });

            // Подсветить линии ладов
            const uniqueFrets = [...new Set(frets.filter(f => f >= 0 && f < NUM_FRETS))];
            uniqueFrets.forEach(f => {
                const marks = fretsLayer.querySelectorAll('.fret-mark');
                if (marks[f]) marks[f].classList.add('active');
                // Точки
                fretZones[f].querySelectorAll('.fret-dot').forEach(d => d.classList.add('active'));
            });
        }

        // ==================== АНИМАЦИЯ ====================
        function animateStrings() {
            ['str0','str1','str2'].forEach(id => {
                const s = document.getElementById(id);
                s.classList.remove('vibrating', 'glow');
                void s.offsetWidth;
                s.classList.add('vibrating', 'glow');
                setTimeout(() => s.classList.remove('vibrating', 'glow'), 1000);
            });
        }

        function createParticles(noteIndex) {
            const balalaika = document.querySelector('.balalaika');
            const colors = ['#f4d35e','#ff6b6b','#48dbfb','#ff9ff3','#54a0ff','#5f27cd','#01a3a4'];
            for (let i = 0; i < 8; i++) {
                const p = document.createElement('div');
                p.className = 'particle';
                const sz = Math.random() * 6 + 3;
                p.style.width = sz + 'px'; p.style.height = sz + 'px';
                p.style.background = colors[noteIndex];
                p.style.left = (140 + (Math.random() - 0.5) * 80) + 'px';
                p.style.top = (380 + Math.random() * 60) + 'px';
                p.style.setProperty('--tx', (Math.random() - 0.5) * 130 + 'px');
                p.style.setProperty('--ty', -(Math.random() * 100 + 20) + 'px');
                balalaika.appendChild(p);
                setTimeout(() => p.remove(), 800);
            }
        }

        function createNoteWave(noteIndex) {
            const balalaika = document.querySelector('.balalaika');
            const nw = document.createElement('div');
            nw.className = 'note-wave';
            nw.textContent = ['🎵','🎶','♪','♫','🎼'][Math.floor(Math.random() * 5)];
            nw.style.left = (120 + Math.random() * 60) + 'px';
            nw.style.top = '350px';
            balalaika.appendChild(nw);
            setTimeout(() => nw.remove(), 1200);
        }

        // ==================== УПРАВЛЕНИЕ ====================
        // Кнопки нот
        document.querySelectorAll('.note-btn[data-note]').forEach(btn => {
            const handler = (e) => {
                if (e) e.preventDefault();
                playNote(parseInt(btn.dataset.note));
                btn.classList.add('pressed');
            };
            btn.addEventListener('mousedown', handler);
            btn.addEventListener('touchstart', handler);
            btn.addEventListener('mouseup', () => btn.classList.remove('pressed'));
            btn.addEventListener('mouseleave', () => btn.classList.remove('pressed'));
            btn.addEventListener('touchend', () => btn.classList.remove('pressed'));
        });

        // Кнопка открытых струн
        const openBtn = document.getElementById('openBtn');
        openBtn.addEventListener('mousedown', () => { playOpenStrings(); openBtn.classList.add('pressed'); });
        openBtn.addEventListener('touchstart', (e) => { e.preventDefault(); playOpenStrings(); openBtn.classList.add('pressed'); });
        openBtn.addEventListener('mouseup', () => openBtn.classList.remove('pressed'));
        openBtn.addEventListener('mouseleave', () => openBtn.classList.remove('pressed'));
        openBtn.addEventListener('touchend', () => openBtn.classList.remove('pressed'));

        // Клавиатура
        document.addEventListener('keydown', (e) => {
            if (e.repeat) return;
            const key = e.key.toLowerCase();
            const idx = noteKeys.indexOf(key);
            if (idx !== -1) {
                playNote(idx);
                const btn = document.querySelector(`.note-btn[data-note="${idx}"]`);
                if (btn) btn.classList.add('pressed');
            }
            if (key === 'z') {
                playOpenStrings();
                openBtn.classList.add('pressed');
            }
        });
        document.addEventListener('keyup', (e) => {
            const key = e.key.toLowerCase();
            const idx = noteKeys.indexOf(key);
            if (idx !== -1) document.querySelector(`.note-btn[data-note="${idx}"]`)?.classList.remove('pressed');
            if (key === 'z') openBtn.classList.remove('pressed');
        });
    </script>
</body>
</html>
